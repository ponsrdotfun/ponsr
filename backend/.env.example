# Copy this file to .env and fill in real values.
# backend/docs/SETUP.md says where to get each credential below.
# NEVER commit a real .env file.

# -- LLM parser (Part 9: Claude Haiku 4.5) --
ANTHROPIC_API_KEY=
PARSER_MODEL=claude-haiku-4-5

# -- X: reads and writes go to DIFFERENT providers. See backend/src/xClient.ts for why. --
#
# READ (mentions, account signals) -- twitterapi.io.
# ~$0.00015 per matched tweet against X's own $0.005 per post read: 33x cheaper, on the side
# where volume actually lands. Reading is invisible as account activity, so the third party
# carries no account risk.
TWITTERAPI_IO_KEY=
BOT_X_HANDLE=ponsrdotfun

# WRITE (replies) -- X's own API, OAuth 1.0a, from developer.x.com.
# ~$0.015 per reply, and one reply per launch. Posting is what X sees @ponsrdotfun doing, and
# a suspended account cannot be re-minted -- unlike a domain or a contract. Paying X directly
# retires the question of whether automated posting via a third party is within their rules.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ⚠️ A POST CONTAINING A URL COSTS $0.200 INSTEAD OF $0.015 -- thirteen times more.
# At 100 launches/month: $20 with the link, $1.50 without. Off by default so the cost is
# chosen rather than discovered. The contract address is in the reply either way.
REPLY_INCLUDE_LINK=false
SITE_BASE_URL=https://ponsr.fun

# -- Robinhood Chain RPC (Part 10: Alchemy free tier is very likely sufficient to start) --
# Testnet default shown. Switch to mainnet (chain ID 4663) only after Phase 1-3 are complete
# and validated, per the implementation roadmap.
RPC_URL=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630

# Optional extra read endpoints, comma-separated, tried in order after RPC_URL.
# EMPTY BY DEFAULT, and leaving it empty keeps today's behaviour exactly.
#
# Read path only: the launch path keeps a single pinned provider, because failing over
# mid-launch reserves a nonce on one node and broadcasts through another.
#
# Every entry is ADMITTED before it may answer -- observed chain id must equal the
# deployment's, and the factory's runtime bytecode must hash to the registry's value. An
# endpoint that fails either is refused, not used with a warning. Note the line above:
# RPC_URL here is TESTNET, and on testnet the mainnet factory address holds no contract at
# all, so pasting a testnet URL in as a "backup" is refused rather than silently obeyed.
RPC_FALLBACK_URLS=

# -- pons factory --
# THERE IS NO FACTORY SETTING. Which contract a launch goes to is decided by the registry
# in backend/src/deployments.ts, which binds each factory to an ABI hash, a runtime
# bytecode hash, a selector and an escrow, and refuses to run unless exactly one entry is
# executable. The verified ABIs are checked in at backend/src/abi/, pulled from
# robinhoodchain.blockscout.com, which needs no API key.
#
# PONS_FACTORY_VERSION, PONS_FACTORY_ADDRESS and PONS_LOCKER_ADDRESS were removed on
# 2026-08-26. The first defaulted to v1, so an environment that simply did not mention it
# launched through the superseded factory -- which is what happened, twice, in production
# on 2026-08-12. One fact must not live in two places.
# Independent Ponsr gate. Keep false through deploy and canary; enable only after fee
# reconciliation. Exact strings only: "false" must not coerce to true.
PUBLIC_LAUNCH_ENABLED=false

# -- Wallet-per-user: Privy (Part 10) --
# Dashboard -> your app -> Settings. The secret is a server credential; it never goes near
# a browser. Note the SDK is @privy-io/node -- @privy-io/server-auth is deprecated.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# -- Account Phase B: X OAuth 2.0 Authorization Code + PKCE --
# Keep disabled until the X app has the exact callback URL below and deployment-level
# OAuth/Privy continuity tests pass. Login is lookup-only and never creates a wallet.
ACCOUNT_AUTH_ENABLED=false
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_CALLBACK_URL=https://ponsr.fun/api/auth/x/callback
ACCOUNT_SITE_ORIGIN=https://ponsr.fun

# -- Treasury signer: Turnkey (Part 10) --
# ⚠️ THE POLICY IS NOT IN THIS FILE, AND NOT IN THE CODE. It lives in Turnkey.
# These credentials let the bot ASK Turnkey to sign. What stops that key signing "send the
# treasury to an attacker" is a policy you configure in Turnkey's dashboard/API:
#     destination == the executable factory only
#     function selector == launchToken only
#     per-transaction value ceiling == TREASURY_MAX_FEE_WEI
# Without it, a Turnkey key is a bare key that merely looks protected.
#
# Also note: deploying a splitter is a contract creation, not a call to the factory, so a
# policy scoped only to launchToken will reject it. Decide deliberately whether to widen the
# policy or use a separate signer for deployments -- before mainnet, not during it.
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# Wallet account address, private key address, or private key ID to sign with.
# The treasury's EVM address, as a non-secret pin. Separate from TURNKEY_SIGN_WITH,
# which Turnkey also accepts as an opaque private-key ID -- and an identifier read as an
# address produces a preflight describing an account that does not exist.
TREASURY_ADDRESS=

TURNKEY_SIGN_WITH=
# Set to true ONLY after the policy above exists. Production refuses to start otherwise.
TURNKEY_POLICY_CONFIRMED=false

# -- Treasury signer: raw key (testnet / Phase B only) --
# ⚠️ TESTNET ONLY. Never set this in a production environment -- treasurySigner.ts refuses to
# use it when NODE_ENV=production. Production MUST use Turnkey (see treasurySigner.ts).
TREASURY_SIGNER_PRIVATE_KEY=
# Max fee (wei) the bot will ever pay for a single launch, regardless of what pons reports live.
TREASURY_MAX_FEE_WEI=2000000000000000

# -- Hot/cold treasury split (Part 5 mitigation #7) --
# The wallet above is the HOT wallet: the bot spends from it and only from it. Keep the bulk
# of the treasury in a separate cold/multisig wallet so a hot-key compromise costs a bounded
# amount instead of everything (Part 5 §3.6).
#
# There is deliberately NO cold private key anywhere in this project. The address below is
# used for two things only: naming the source/destination in top-up and sweep alerts, and
# failing loudly at boot if it matches the hot wallet -- which would mean the split is not
# real. Moving funds either way is a manual operator action, on purpose: a bot that could
# refill itself from cold storage would have re-created the single point of failure.
TREASURY_COLD_ADDRESS=
# Hot balance ceiling, as a multiple of DAILY_SPEND_CAP_WEI. The circuit breaker already
# refuses to spend more than the cap per 24h, so anything above ~2 days' worth cannot be
# spent by the bot -- but can still be stolen. Above this, alerts ask you to sweep to cold.
HOT_WALLET_MAX_DAILY_CAPS=2
# Thresholds in LAUNCHES, not ETH -- the launch fee is owner-settable on pons's side and is
# read live, so these need no editing if it changes.
HOT_WALLET_FLOOR_LAUNCHES=20
HOT_WALLET_TARGET_LAUNCHES=60
HOT_WALLET_CRITICAL_LAUNCHES=3
# Held back from launch fees so gas is still payable. One launch is TWO transactions out of
# this wallet (splitter deployment, then the launch itself).
TREASURY_GAS_RESERVE_WEI=2000000000000000

# -- Anti-abuse thresholds (Part 5 -- required Phase 1 mitigations, tune based on real usage) --
DAILY_SPEND_CAP_WEI=50000000000000000
MIN_ACCOUNT_AGE_DAYS=30
MIN_FOLLOWER_COUNT=5
MAX_LAUNCHES_PER_USER_PER_DAY=3

# -- Storage --
DATABASE_PATH=./data/bot.sqlite

PORT=3000
NODE_ENV=development
