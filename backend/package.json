{
  "name": "launch-bot-backend",
  "version": "0.1.0",
  "description": "Twitter-native token launch bot backend for Pons factory on Robinhood Chain",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --runInBand",
    "read:policies": "tsx scripts/turnkey-read-policies.ts",
    "verify:ethcall": "tsx scripts/verify-current-ethcall.ts",
    "launch:canary": "tsx scripts/phase-b-launch.ts",
    "collect:v2": "tsx scripts/collect-and-split-v2.ts",
    "signer:verify-policy": "tsx scripts/turnkey-verify-policy.ts",
    "signer:probe-creation": "tsx scripts/turnkey-probe-creation.ts",
    "verify:policy": "node -e \"console.error('renamed: this SIGNS. use npm run signer:verify-policy'); process.exit(1)\"",
    "probe:creation": "node -e \"console.error('renamed: this SIGNS. use npm run signer:probe-creation'); process.exit(1)\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.35.0",
    "@privy-io/node": "^0.28.0",
    "@turnkey/ethers": "^1.3.32",
    "@turnkey/sdk-server": "^7.0.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "4.23.12",
    "typescript": "^5.7.2"
  }
}
